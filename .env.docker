# --- Auth ---
AUTH_DATABASE_URL=postgres://admin:admin@postgres:5432/auth_db?sslmode=disable
AUTH_GRPC_ADDR=:50051
AUTH_HTTP_ADDR=:8081
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
BOOTSTRAP_ADMIN_EMAIL=admin@bank.com
BOOTSTRAP_ADMIN_PASSWORD=changeme123
KAFKA_GROUP_ID=auth-service

# --- Customer ---
CUSTOMER_DATABASE_URL=postgres://admin:admin@postgres:5432/customer_db?sslmode=disable
CUSTOMER_GRPC_ADDR=:50052
CUSTOMER_REDIS_ADDR=redis:6379
CUSTOMER_KAFKA_GROUP_ID=customer-service

# --- Document ---
DOCUMENT_DATABASE_URL=postgres://admin:admin@postgres:5432/document_db?sslmode=disable
DOCUMENT_GRPC_ADDR=:50054
MINIO_ENDPOINT=minio:9000
DOCUMENT_CUSTOMER_GRPC_ADDR=customer:50052
# Для доступа снаружи (Postman): presigned URL подписываются этим хостом
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
MINIO_USE_SSL=false
DOC_UPLOAD_URL_TTL=15m
DOC_DOWNLOAD_URL_TTL=5m

# --- KYC ---
KYC_DATABASE_URL=postgres://admin:admin@postgres:5432/kyc_db?sslmode=disable
KYC_GRPC_ADDR=:50055
KYC_REQUIRED_DOC_TYPES=PASSPORT,SELFIE

# --- Account ---
ACCOUNT_DATABASE_URL=postgres://admin:admin@postgres:5432/account_db?sslmode=disable
ACCOUNT_GRPC_ADDR=:50056
ACCOUNT_CUSTOMER_GRPC_ADDR=customer:50052
ACCOUNT_KAFKA_BROKERS=kafka:19092
ACCOUNT_KAFKA_TOPIC=kyc.events
ACCOUNT_KAFKA_GROUP_ID=account-service
ACCOUNT_LEDGER_GRPC_ADDR=ledger:50057

# --- Ledger ---
LEDGER_DATABASE_URL=postgres://admin:admin@postgres:5432/ledger_db?sslmode=disable
LEDGER_GRPC_ADDR=:50057
LEDGER_ACCOUNT_GRPC_ADDR=account:50056
LEDGER_KAFKA_BROKERS=kafka:19092
LEDGER_KAFKA_TOPIC=ledger.events

# --- API Gateway ---
GATEWAY_HTTP_ADDR=:8080
GATEWAY_METRICS_ADDR=:9090
GATEWAY_AUTH_GRPC_ADDR=auth:50051
GATEWAY_CUSTOMER_GRPC_ADDR=customer:50052
GATEWAY_DOCUMENT_GRPC_ADDR=document:50054
GATEWAY_KYC_GRPC_ADDR=kyc:50055
GATEWAY_ACCOUNT_GRPC_ADDR=account:50056
GATEWAY_LEDGER_GRPC_ADDR=ledger:50057
GATEWAY_AUTH_JWKS_URL=http://auth:8081/.well-known/jwks.json
GATEWAY_REDIS_ADDR=redis:6379

GATEWAY_OTEL_ENDPOINT=off

# --- Общие ---
KAFKA_BROKERS=kafka:19092
REDIS_ADDR=redis:6379

